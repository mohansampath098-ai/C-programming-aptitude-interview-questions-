Sphenic Number 
 
Python 
n = int(input("Enter number: ")) 
 
count = 0 
product = 1 
 
i = 2 
while i <= n: 
 
    if n % i == 0: 
 
        prime = True 
        j = 2 
 
        while j * j <= i: 
            if i % j == 0: 
                prime = False 
                break 
 
  
 
            j += 1 
 
        if prime == True: 
            count += 1 
            product *= i 
 
    i += 1 
 
if count == 3 and product == n: 
    print("Sphenic Number") 
else: 
    print("Not Sphenic Number") 
 
