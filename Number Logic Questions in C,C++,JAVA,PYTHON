#include <stdio.h> 
int main(){ 
    int n; 
    printf("Enter number: "); 
    scanf("%d",&n); 
 
    int count=0; 
    int product=1; 
 
    for(int i=2;i<=n;i++){ 
 
        if(n%i==0){ 
 
            int prime=1; 
 
            for(int j=2;j*j<=i;j++){ 
                if(i%j==0){ 
                    prime=0; 
                    break; 
                } 
            } 
 
            if(prime==1){ 
                count++; 
                product*=i; 
            } 
        } 
    } 
 
    if(count==3 && product==n) 
        printf("Sphenic Number"); 
    else 
        printf("Not Sphenic Number"); 
} 
 
 
 
 
  
 
